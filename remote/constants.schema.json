{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "默认参数表",
	"description": "除非你知道你在做什么，不然不要改本文件。本方案默认安全，以上是非敏感配置可分享",
	"type": "object",
	"properties": {
		"$schema": {
			"description": "schema文件路径",
			"type": "string",
			"default": "constants.schema.json"
		},
		"username": {
			"description": "服务器sudo用户名。没必要改，用新版OpenSSH不会产生特征",
			"type": "string",
			"default": "3xuser",
			"minLength": 1
		},
		"password": {
			"description": "服务器sudo用户密码。没必要改，服务器没法通过这个密码登陆",
			"type": "string",
			"default": "xxx",
			"minLength": 1
		},
		"3xusername": {
			"description": "3X-UI面板用户名。没必要改，3X-UI面板不会暴露于公网",
			"type": "string",
			"default": "3xuser",
			"minLength": 1
		},
		"3xpassword": {
			"description": "3X-UI密码。没必要改，3X-UI面板不会暴露于公网",
			"type": "string",
			"default": "xxx",
			"minLength": 1
		},
		"initialSshPort": {
			"description": "初始SSH端口",
			"type": "integer",
			"default": 22,
			"minimum": 1,
			"maximum": 65535,
			"not": {
				"enum": [
					80,
					443
				]
			}
		},
		"realityTargetPort": {
			"description": "Reality目标端口",
			"type": "integer",
			"default": 8443,
			"minimum": 1,
			"maximum": 65535,
			"not": {
				"enum": [
					80,
					443
				]
			}
		},
		"fakeSitePort": {
			"description": "Caddy伪装站端口",
			"type": "integer",
			"default": 8085,
			"minimum": 1,
			"maximum": 65535,
			"not": {
				"enum": [
					80,
					443
				]
			}
		},
		"xhttpPort": {
			"description": "Xray XHTTP端口",
			"type": "integer",
			"default": 8087,
			"minimum": 1,
			"maximum": 65535,
			"not": {
				"enum": [
					80,
					443
				]
			}
		},
		"cdnOptDomain": {
			"description": "Cloudflare优选域名，用于额外生成XHTTP订阅主机",
			"type": "string",
			"default": "saas.sin.fan",
			"format": "hostname",
			"minLength": 1,
			"pattern": "^(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
		},
		"subscriptionPort": {
			"description": "3X-UI订阅内部端口",
			"type": "integer",
			"default": 2054,
			"minimum": 1,
			"maximum": 65535,
			"not": {
				"enum": [
					80,
					443
				]
			}
		},
		"localSshPort": {
			"description": "SSH转发本地端口",
			"type": "integer",
			"default": 2053,
			"minimum": 1,
			"maximum": 65535,
			"not": {
				"enum": [
					80,
					443
				]
			}
		},
		"3xpanelPort": {
			"description": "3X-UI面板端口",
			"type": "integer",
			"default": 2053,
			"minimum": 1,
			"maximum": 65535,
			"not": {
				"enum": [
					80,
					443
				]
			}
		},
		"3xpanelUriPath": {
			"description": "3X-UI面板URI路径（只能含字母和数字，至少5位）",
			"type": "string",
			"default": "3xpanel",
			"minLength": 5,
			"pattern": "^[a-zA-Z0-9]+$"
		},
		"clashSubscriptionPathSuffix": {
			"description": "Clash订阅路径追加字符串",
			"type": "string",
			"default": "c",
			"minLength": 1
		}
	},
	"required": [
		"username",
		"password",
		"3xusername",
		"3xpassword",
		"initialSshPort",
		"realityTargetPort",
		"fakeSitePort",
		"xhttpPort",
		"cdnOptDomain",
		"subscriptionPort",
		"clashSubscriptionPathSuffix",
		"localSshPort",
		"3xpanelPort",
		"3xpanelUriPath"
	],
	"additionalProperties": false
}
