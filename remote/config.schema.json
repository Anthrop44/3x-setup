{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "用户配置文件",
	"description": "敏感配置，请勿泄露！",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"ip": {
			"description": "服务器IP地址。IPv6请加方括号",
			"type": "string",
			"oneOf": [
				{
					"format": "ipv4",
					"pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
				},
				{
					"pattern": "^\\[((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:))\\]$"
				}
			]
		},
		"directDomain": {
			"description": "直连域名",
			"type": "string",
			"format": "hostname",
			"pattern": "^(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
		},
		"cdnDomain": {
			"description": "CDN域名",
			"type": "string",
			"format": "hostname",
			"pattern": "^(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
		},
		"cdnPort": {
			"description": "CDN回源端口（大于10000）",
			"type": "integer",
			"minimum": 10001,
			"maximum": 65535
		},
		"clients": {
			"description": "客户端列表",
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"client": {
						"description": "客户名（只能有英文字母、数字和连字符。Windows保留文件名也不能用）",
						"type": "string",
						"minLength": 1,
						"pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])$)[A-Za-z0-9-]+$"
					},
					"traffic": {
						"description": "每月流量上限（GB）",
						"type": "integer",
						"minimum": 0
					},
					"path": {
						"description": "（自动生成，请勿手动设置）客户订阅路径",
						"type": "string",
						"minLength": 16,
						"maxLength": 16,
						"pattern": "^[a-zA-Z0-9]+$"
					}
				},
				"required": [
					"client"
				],
				"additionalProperties": false
			}
		},
		"sshPort": {
			"description": "（自动生成，请勿手动设置）新ssh端口号",
			"type": "integer",
			"minimum": 10001,
			"maximum": 65535
		},
		"subscriptionPath": {
			"description": "（自动生成，请勿手动设置）共享订阅路径",
			"type": "string",
			"minLength": 16,
			"maxLength": 16,
			"pattern": "^[a-zA-Z0-9]+$"
		},
		"distributionPath": {
			"description": "（自动生成，请勿手动设置）订阅+教程+客户端公开分发路径",
			"type": "string",
			"minLength": 15,
			"maxLength": 15,
			"pattern": "^[a-zA-Z0-9]+$"
		}
	},
	"required": [
		"ip",
		"directDomain",
		"cdnDomain",
		"cdnPort",
		"clients"
	],
	"additionalProperties": false
}
