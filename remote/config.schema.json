{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "用户配置文件",
	"description": "敏感配置，请勿泄露！",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"directDomain": {
			"description": "直连域名",
			"type": "string",
			"format": "hostname",
			"pattern": "^(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
		},
		"cdnDomain": {
			"description": "CDN域名",
			"type": "string",
			"format": "hostname",
			"pattern": "^(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
		},
		"cdnPort": {
			"description": "CDN回源端口（大于10000）",
			"type": "integer",
			"minimum": 10001,
			"maximum": 65535
		},
		"cdnOptDomains": {
			"description": "（可选）Cloudflare优选域名列表",
			"type": "array",
			"uniqueItems": true,
			"items": {
				"description": "Cloudflare优选域名。需要能解析到Cloudflare anycast ip",
				"type": "string",
				"format": "hostname",
				"default": [
					"www.shopify.com",
					"time.is",
					"japan.com",
					"pubs.acs.org"
				],
				"pattern": "^(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
			}
		},
		"cdnEchConfigList": {
			"description": "（可选）为所有cdnDomain配置ECH，保留原普通TLS节点。建议填客户端可直达的DoH地址，如`https://1.1.1.1/dns-query`；也支持Xray的固定ECHConfigList和域名+DNS格式。删除本字段即可关闭",
			"type": "string",
			"minLength": 1,
			"pattern": "^\\S+$"
		},
		"clients": {
			"description": "客户端列表",
			"type": "array",
			"uniqueItems": true,
			"items": {
				"type": "object",
				"properties": {
					"client": {
						"description": "客户名（只能有英文字母、数字和连字符。操作系统保留文件名也不能用）",
						"type": "string",
						"minLength": 1,
						"pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])$)[A-Za-z0-9-]+$"
					},
					"traffic": {
						"description": "每月流量上限（GB）",
						"type": "integer",
						"minimum": 0
					},
					"password": {
						"description": "（缺失时自动生成，重建时复用）分发页解锁密码，八位数字字符串，可含前导零",
						"type": "string",
						"minLength": 8,
						"maxLength": 8,
						"pattern": "^[0-9]{8}$"
					},
					"path": {
						"description": "（自动生成，请勿手动设置）客户订阅路径",
						"type": "string",
						"minLength": 16,
						"maxLength": 16,
						"pattern": "^[a-zA-Z0-9]+$"
					}
				},
				"required": [
					"client"
				],
				"additionalProperties": false
			}
		},
		"sshPort": {
			"description": "（自动生成，请勿手动设置）新ssh端口号",
			"type": "integer",
			"minimum": 10001,
			"maximum": 65535
		},
		"subscriptionPath": {
			"description": "（自动生成，请勿手动设置）共享订阅路径",
			"type": "string",
			"minLength": 16,
			"maxLength": 16,
			"pattern": "^[a-zA-Z0-9]+$"
		},
		"distributionPath": {
			"description": "（自动生成，请勿手动设置）订阅+教程+客户端公开分发路径",
			"type": "string",
			"minLength": 15,
			"maxLength": 15,
			"pattern": "^[a-zA-Z0-9]+$"
		}
	},
	"required": [
		"directDomain",
		"cdnDomain",
		"cdnPort",
		"clients"
	],
	"additionalProperties": false
}
